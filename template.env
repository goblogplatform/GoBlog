# goblog's .env, for setting a site up without the install wizard (from
# configuration management, say). The wizard writes this file itself, so a
# normal install does not need it. goblog reads .env from its working
# directory, or from GOBLOG_DATA_DIR when that is set; values already in the
# process environment take precedence.
#
# Without an admin, the wizard still opens to create one (it asks for the
# setup code goblog prints to its log); or set client_id/client_secret below
# and the first GitHub login becomes the admin.

# the session cookie's signing key: 36 characters, e.g. from `uuidgen`.
# goblog writes one if it is missing; changing it signs everybody out.
# SESSION_KEY=

# database: sqlite, mysql or postgres
database=sqlite
# a relative path is inside GOBLOG_DATA_DIR when that is set
sqlite_db=goblog.db

# mysql
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=goblog
# MYSQL_PASSWORD=
# MYSQL_DATABASE=goblog

# postgres
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_USER=goblog
# POSTGRES_PASSWORD=
# POSTGRES_DATABASE=goblog
# POSTGRES_SSLMODE=disable

# optional: GitHub login, from a GitHub OAuth app whose callback URL is
# https://<your site>/login
# client_id=
# client_secret=

# optional: pin admin promotion to a specific GitHub account. When either is
# set, only a matching user is promoted to admin on first login; when both are
# unset, the first user to log in becomes admin. Either one matching is enough.
# admin_login=<github username, case-insensitive>
# admin_github_id=<numeric github user id, e.g. from https://api.github.com/users/<username>>

# optional: email (one-time code) login for visitors. Enabled when both
# smtp_host and smtp_from are set. smtp_port 465 uses implicit TLS; any other
# port (default 587) uses STARTTLS when the server offers it. Leave smtp_user
# unset for a relay that does not need authentication. Email users cannot be
# admins.
# smtp_host=smtp.example.com
# smtp_port=587
# smtp_user=postmaster@example.com
# smtp_password=<smtp password>
# smtp_from=blog@example.com
